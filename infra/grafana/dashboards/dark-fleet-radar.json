{
  "uid": "dark-fleet-radar",
  "title": "Dark Fleet Radar",
  "tags": [
    "ais",
    "flink"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Mensajes AIS por minuto",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prom"
          },
          "expr": "sum(rate(ais_messages_published_total[$__rate_interval])) * 60",
          "legendFormat": "msg/min"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "% a la DLQ (1 h)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prom"
          },
          "expr": "100 * (sum(increase(ais_messages_invalid_total[1h])) or vector(0)) / clamp_min(sum(increase(ais_messages_received_total[1h])), 1)",
          "legendFormat": "DLQ"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Retraso medio del evento",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prom"
          },
          "expr": "sum(rate(ais_event_delay_seconds_sum[$__rate_interval])) / clamp_min(sum(rate(ais_event_delay_seconds_count[$__rate_interval])), 1e-9)",
          "legendFormat": "s"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Checkpoints completados (Flink)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prom"
          },
          "expr": "sum(flink_jobmanager_job_numberOfCompletedCheckpoints)",
          "legendFormat": "ok"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Checkpoints fallidos (Flink)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prom"
          },
          "expr": "sum(flink_jobmanager_job_numberOfFailedCheckpoints)",
          "legendFormat": "fail"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Alertas en el rango",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "radar-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FROM alerts WHERE $__timeFilter(end_time)"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "radar-pg"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "geomap",
      "title": "Alertas en el mapa (color = tipo, tamaño = puntaje)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "radar-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT lat AS latitude, lon AS longitude, alert_type, mmsi, score, end_time\nFROM alerts\nWHERE lat IS NOT NULL AND $__timeFilter(end_time)\nORDER BY end_time DESC LIMIT 5000"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "radar-pg"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alert_type"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "spoofing_jump": {
                        "color": "red",
                        "index": 0
                      },
                      "sanctioned_vessel": {
                        "color": "dark-purple",
                        "index": 1
                      },
                      "identity_change": {
                        "color": "orange",
                        "index": 2
                      },
                      "dark_gap": {
                        "color": "blue",
                        "index": 3
                      },
                      "sts_encounter": {
                        "color": "yellow",
                        "index": 4
                      },
                      "cable_loitering": {
                        "color": "green",
                        "index": 5
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 57,
          "lon": 13,
          "zoom": 4.3
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OpenStreetMap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Alertas",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": false,
              "style": {
                "color": {
                  "field": "alert_type",
                  "fixed": "red"
                },
                "size": {
                  "field": "score",
                  "min": 4,
                  "max": 12,
                  "fixed": 6
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "opacity": 0.8
              }
            },
            "tooltip": true
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 8,
      "type": "geomap",
      "title": "Cobertura AIS: mensajes por celda H3 en la última hora cerrada",
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "radar-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT lat AS latitude, lon AS longitude, messages, vessels\nFROM coverage_hourly\nWHERE lat IS NOT NULL AND window_start = (\n  SELECT max(window_start) FROM coverage_hourly\n  WHERE lat IS NOT NULL AND window_start < now() AT TIME ZONE 'UTC')"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "radar-pg"
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 57,
          "lon": 13,
          "zoom": 3.6
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OpenStreetMap"
        },
        "layers": [
          {
            "type": "heatmap",
            "name": "Cobertura",
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "weight": {
                "field": "messages",
                "min": 0,
                "max": 1,
                "fixed": 1
              },
              "blur": 12,
              "radius": 6
            }
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Alertas por hora y tipo",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "radar-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(end_time, 1h), alert_type AS metric, count(*) AS value\nFROM alerts WHERE $__timeFilter(end_time)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "radar-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "spoofing_jump"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sanctioned_vessel"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "identity_change"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dark_gap"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sts_encounter"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cable_loitering"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Alertas por tipo (barcos distintos)",
      "gridPos": {
        "x": 14,
        "y": 18,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "radar-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT alert_type, count(DISTINCT mmsi) AS barcos\nFROM alerts WHERE $__timeFilter(end_time)\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "radar-pg"
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^barcos$/"
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Últimas alertas",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "radar-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT end_time AS hora_utc, alert_type AS tipo, mmsi, imo,\n       round(score::numeric, 2) AS puntaje, evidence AS evidencia\nFROM alerts WHERE $__timeFilter(end_time)\nORDER BY end_time DESC LIMIT 200"
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "radar-pg"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "evidencia"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 700
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Duración del último checkpoint por job (Flink)",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prom"
          },
          "expr": "max by (job_name) (flink_jobmanager_job_lastCheckpointDuration)",
          "legendFormat": "{{job_name}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Mensajes publicados por tipo (por segundo)",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "radar-prom"
          },
          "expr": "sum by (type) (rate(ais_messages_published_total[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "radar-prom"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ]
}
