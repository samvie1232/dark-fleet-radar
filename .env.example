# Copia este archivo como .env y completa tu API key. Nunca subas .env a Git.
AISSTREAM_API_KEY=

# Región: Báltico + Mar del Norte. Formato aisstream: [[[lat_min, lon_min], [lat_max, lon_max]], ...]
AIS_BOUNDING_BOXES=[[[50.0, -5.0], [66.0, 31.0]]]

# Tipos de mensaje que se piden a aisstream (separados por coma)
AIS_MESSAGE_TYPES=PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,ShipStaticData,StaticDataReport

KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_RAW=ais.raw
KAFKA_TOPIC_DLQ=ais.dlq

# Grabación JSONL para replay (vacío = desactivado). Un archivo por hora UTC.
AIS_RECORD_DIR=/data/raw

METRICS_PORT=8000
LOG_LEVEL=INFO

# Puertos en tu PC (cámbialos si ya están ocupados, p. ej. por Airflow en 8080)
CONSOLE_PORT=8090
METRICS_HOST_PORT=8000
